{
  "name": "epubbuilder",
  "version": "1.3.2",
  "description": "build epub files from txt file",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/test-chapter-fixtures.js && node scripts/smoke-epub.js && node scripts/smoke-cli-pipeline.js",
    "test:fixtures": "node scripts/test-chapter-fixtures.js",
    "lint": "eslint src scripts",
    "audit:check": "npm audit --audit-level=high"
  },
  "bin": {
    "epubbuild": "./src/build.js",
    "splite": "./src/splite.js",
    "zipFile": "./src/zipFile.js",
    "convFile": "./src/convFile.js",
    "mdconver": "./src/mdconver.js",
    "mergetxt": "./src/merge.js",
    "preformat": "./src/preformat.js",
    "renameDir": "./src/renameDir.js",
    "s2t": "./src/s2t.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakerlin/epubBuilder.git"
  },
  "keywords": [
    "epub",
    "builder"
  ],
  "author": "saker",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sakerlin/epubBuilder/issues"
  },
  "homepage": "https://github.com/sakerlin/epubBuilder#readme",
  "dependencies": {
    "chardet": "^2.2.0",
    "commander": "^14.0.0",
    "iconv-lite": "^0.7.3",
    "opencc-js": "^1.4.2",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "neostandard": "^0.13.0"
  }
}
